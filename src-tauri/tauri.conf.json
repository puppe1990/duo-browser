{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Duo Browser",
  "version": "0.1.0",
  "identifier": "com.gestaobem.duobrowser",
  "build": { "frontendDist": "../web" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Duo Browser · Controle",
        "width": 620,
        "height": 650,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": { "../native/DuoNative.app/": "DuoNative.app/" },
    "macOS": { "minimumSystemVersion": "14.0" }
  }
}
